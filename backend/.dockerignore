# ============================================================
# DOCKER IGNORE
# Files and directories to exclude from Docker build context
# ============================================================

# Node modules
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
dist/
build/
coverage/
.nyc_output/

# Environment files
.env
.env.*
!.env.example
!.env.test
!.env.production

# Git
.git/
.gitignore
.gitattributes

# Docker files
dockerfile
dockerfile.dev
docker-compose.yml
.dockerignore

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
logs/
*.log
*.pid
*.seed
*.pid.lock

# Testing
tests/
**/*.test.ts
**/*.spec.ts
jest.config.js
jest.setup.js
vitest.config.ts
playwright.config.ts

# Prisma
prisma/*.db
prisma/*.sqlite
prisma/*.sqlite-journal
prisma/migrations/*.sql

# Documentation
docs/
README.md
LICENSE
swagger.yaml
openapi.yaml

# Other
.prettierrc
.prettierignore
.eslintrc.json
.eslintignore
commitlint.config.js
.husky/
nodemon.json
.vercel
.railway
*.orig
*.rej
*.patch
*.diff

# Backup files
*.backup
*.bak
*.tmp