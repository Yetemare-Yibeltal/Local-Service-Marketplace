# ============================================================
# APPLICATION
# ============================================================

NODE_ENV=production
PORT=5000

# ============================================================
# DATABASE
# ============================================================

# PostgreSQL production connection string
DATABASE_URL=postgresql://username:password@production-db-host:5432/service_marketplace_production

# ============================================================
# REDIS CACHE
# ============================================================

REDIS_URL=redis://username:password@production-redis-host:6379

# ============================================================
# JWT AUTHENTICATION
# ============================================================

# MUST BE STRONG SECRETS - Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=your_production_access_secret_at_least_32_characters
JWT_REFRESH_SECRET=your_production_refresh_secret_at_least_32_characters
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ============================================================
# EMAIL (SMTP)
# ============================================================

SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key

# ============================================================
# SMS (TWILIO)
# ============================================================

TWILIO_ACCOUNT_SID=your_production_twilio_sid
TWILIO_AUTH_TOKEN=your_production_twilio_token
TWILIO_PHONE_NUMBER=+251900000000

# ============================================================
# FILE STORAGE (CLOUDINARY)
# ============================================================

CLOUDINARY_CLOUD_NAME=your_production_cloud_name
CLOUDINARY_API_KEY=your_production_api_key
CLOUDINARY_API_SECRET=your_production_api_secret

# ============================================================
# MAPS (MAPBOX)
# ============================================================

MAPBOX_ACCESS_TOKEN=your_production_mapbox_token

# ============================================================
# CORS
# ============================================================

# Production frontend URLs (comma-separated)
CORS_ORIGIN=https://your-production-domain.com,https://api.your-production-domain.com

# ============================================================
# RATE LIMITING
# ============================================================

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================
# PAYMENT GATEWAYS
# ============================================================

# Telebirr Production
TELEBIRR_ENABLED=true
TELEBIRR_API_KEY=your_production_telebirr_key
TELEBIRR_MERCHANT_ID=your_production_merchant_id
TELEBIRR_CALLBACK_URL=https://api.your-production-domain.com/api/v1/webhooks/telebirr

# Chapa Production
CHAPA_ENABLED=true
CHAPA_API_KEY=your_production_chapa_key
CHAPA_CALLBACK_URL=https://api.your-production-domain.com/api/v1/webhooks/chapa

# ============================================================
# APPLICATION URL
# ============================================================

APP_URL=https://your-production-domain.com

# ============================================================
# LOGGING
# ============================================================

LOG_LEVEL=info