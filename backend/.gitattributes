# ============================================================
# GIT ATTRIBUTES
# Configuration for line endings and diff handling
# ============================================================

# Auto-detect text files and ensure LF line endings
* text=auto

# Source code files - force LF line endings
*.ts text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.md text eol=lf

# Shell scripts - force LF line endings (must be LF for execution)
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf

# Windows batch files - force CRLF line endings
*.bat text eol=crlf
*.cmd text eol=crlf

# Configuration files
*.env text
*.env.* text
.env text
.env.* text
*.conf text
*.config text

# Lock files - treat as binary to avoid merge conflicts
package-lock.json binary
yarn.lock binary
pnpm-lock.yaml binary
*.lock binary

# Database files - binary
*.db binary
*.sqlite binary
*.sqlite3 binary
*.sqlite-journal binary

# Log files - binary
*.log binary
npm-debug.log binary

# Build outputs - binary
*.o binary
*.so binary
*.dll binary
*.exe binary
*.class binary
*.jar binary
*.war binary
*.ear binary

# Images - binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.webp binary
*.bmp binary
*.tiff binary

# Videos - binary
*.mp4 binary
*.webm binary
*.mov binary
*.avi binary
*.mkv binary

# Audio - binary
*.mp3 binary
*.wav binary
*.ogg binary
*.flac binary

# Documents - binary
*.pdf binary
*.doc binary
*.docx binary
*.xls binary
*.xlsx binary
*.ppt binary
*.pptx binary
*.zip binary
*.tar binary
*.gz binary
*.rar binary
*.7z binary

# Archives - binary
*.zip binary
*.tar.gz binary
*.tgz binary
*.rar binary
*.7z binary

# Keys and certificates - binary
*.pem binary
*.p12 binary
*.key binary
*.crt binary
*.cert binary
*.pfx binary

# Docker files - text
dockerfile text eol=lf
dockerfile.* text eol=lf
.dockerignore text

# Linguist overrides (for GitHub language stats)
*.prisma linguist-language=Prisma
*.twig linguist-language=Twig
*.env linguist-language=Properties