# ============================================================
# ESLINT IGNORE
# Files and directories to exclude from ESLint linting
# ============================================================

# Dependencies
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# Build outputs
dist/
build/
coverage/
.nyc_output/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files
.env
.env.*
!.env.example

# Prisma generated files
prisma/generated/
prisma/*.db
prisma/*.sqlite
prisma/*.sqlite-journal
prisma/seed.ts
prisma/schema.prisma

# Test files (if you want to lint them separately)
tests/
**/*.test.ts
**/*.spec.ts
jest.config.js
jest.setup.js
vitest.config.ts
playwright.config.ts

# Configuration files
*.config.js
*.config.ts
.eslintrc.json
.prettierrc
commitlint.config.js
nodemon.json

# Docker files
dockerfile
dockerfile.dev
docker-compose.yml
.dockerignore

# Documentation
docs/
README.md
LICENSE

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.backup
*.orig
*.rej
*.patch
*.diff
*.merge

# Git
.git/
.gitignore
.gitattributes
.gitmodules

# CI/CD
.github/
.vercel
.railway
.aws
.terraform